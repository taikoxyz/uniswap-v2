pragma solidity >=0.6.6;

import {Script} from "../lib/forge-std/src/Script.sol";
import "forge-std/console2.sol";
// import "../src/erc20/xERC20.sol";
import "multicall/Multicall.sol";

import {UniswapV2Router02} from "@uniswap/v2-periphery/contracts/UniswapV2Router02.sol";
import {UniswapV2Router01} from "@uniswap/v2-periphery/contracts/UniswapV2Router01.sol";

contract UniswapDeployer is Script {
    // Bytecodes - from the /out directory!
    bytes public constant WETH_BYTECODE = hex"";
    bytes public constant FACTORY_BYTECODE = hex"";

    bytes public constant PAIR_BYTECODE = hex"";

    address public constant DEPLOYER_ADDRESS = 0x394Fb4f9fA0F8981E648B2Dd11c973561898C7db;

    modifier broadcast() {
        uint256 deployerPK = vm.envUint("DEPLOYER_PK");
        vm.startBroadcast(deployerPK);
        _;
        vm.stopBroadcast();
    }

    function calculateInitCodeHash() public pure returns (bytes32) {
        return keccak256(abi.encodePacked(PAIR_BYTECODE));
    }

    function run() public broadcast {
        // Deploy WETH
        bytes memory wethBytecode = WETH_BYTECODE;
        address weth;
        assembly {
            weth := create(0, add(wethBytecode, 0x20), mload(wethBytecode))
        }
        console2.log("WETH deployed at:", weth);

        // Deploy Factory
        bytes memory factoryConstructorArgs = abi.encode(DEPLOYER_ADDRESS);
        bytes memory factoryBytecode = abi.encodePacked(FACTORY_BYTECODE, factoryConstructorArgs);

        address factory;
        assembly {
            factory := create(0, add(factoryBytecode, 0x20), mload(factoryBytecode))
        }
        console2.log("UniswapV2Factory deployed at:", factory);

        // Deploy Router01
        address router1 = address(new UniswapV2Router01(factory, weth));
        console2.log("Router01 deployed at:", router1);

        address router2 = address(new UniswapV2Router02(factory, weth));
        console2.log("Router02 deployed at:", router2);

        // Calculate and log init code hash first
        bytes32 initCodeHash = calculateInitCodeHash();
        console2.log("Init Code Hash:");
        console2.logBytes32(initCodeHash);

        address multiCall = address(new Multicall());
        console2.log("Deployed Multicall contract:", multiCall);
    }
}